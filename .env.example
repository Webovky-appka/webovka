# Zkopírujte na .env a doplňte hodnoty. .env není ve gitu.

# Databáze. Pro lokální vývoj odpovídá docker-compose.dev.yml.
DATABASE_URL="postgresql://webappka:webappka@localhost:5433/webappka?schema=public"

# Tajný klíč pro podepisování session cookies. Vygenerujte: openssl rand -base64 32
SESSION_SECRET=""

# Veřejná URL aplikace. Používá se pro sestavení odkazů do klientského portálu.
APP_URL="http://localhost:3000"

# Úložiště příloh: "local" (soubory v .uploads/) nebo "blob" (Vercel Blob).
STORAGE_DRIVER="local"

# Token pro Vercel Blob. Potřeba jen když STORAGE_DRIVER="blob".
BLOB_READ_WRITE_TOKEN=""

# E-mailové notifikace (Resend). Bez API klíče se zprávy jen vypíšou do konzole,
# takže lokální vývoj funguje i bez účtu.
RESEND_API_KEY=""
# Odesílatel. Doména musí být v Resendu ověřená DNS záznamy.
MAIL_FROM=""
# Komu chodí notifikace o aktivitě klientů. Prázdné = všem interním účtům.
NOTIFY_EMAILS=""
# Podpis v e-mailech pro klienty.
MAIL_SIGNATURE=""

# Návrhy e-mailů klientům. Bez klíče se návrh složí ze šablony a nic se
# neposílá mimo aplikaci. Pozor: s klíčem se podklady o zakázce posílají do OpenAI.
OPENAI_API_KEY=""
# Volitelně jiný model. Výchozí je gpt-4o-mini.
OPENAI_MODEL=""

# Odesílání e-mailů z Gmailu a zakládání dokumentů v Google Docs. Vlastní OAuth
# klient z Google Cloud Console, postup je v DEPLOYMENT.md, sekce 4c a 4d.
# Redirect URI musí odpovídat APP_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Čtení repozitářů zakázek z GitHubu. Fine-grained PAT s právy Contents: Read,
# Pull requests: Read, Actions: Read. Postup je v DEPLOYMENT.md, sekce 4e.
# Bez tokenu záložka GitHub jen řekne, že token chybí.
GITHUB_TOKEN=""

# Výchozí pořadí účtu Google pro rychlé odkazy na Gmail a Docs v navigaci.
# Číslo z adresy, když jste v Gmailu přihlášen: mail.google.com/mail/u/6 → 6.
# Každý si svoje pořadí nastaví v Nastavení; tohle platí, dokud si ho nenastaví.
GOOGLE_ACCOUNT_INDEX="0"

# Údaje zhotovitele do smluv. Co chybí, bude ve smlouvě označené [DOPLŇTE].
STUDIO_NAME=""
STUDIO_ICO=""
# Nechte prázdné, pokud nejste plátce DPH.
STUDIO_DIC=""
STUDIO_ADDRESS=""
STUDIO_BANK_ACCOUNT=""
# Kdo za studio smlouvu podepisuje. Prázdné = jméno přihlášeného uživatele.
STUDIO_REPRESENTED_BY=""

# Modely pro AI Sales Engine. Nepovinné — výchozí je gpt-4o na hledání
# (web search chce silnější model) a gpt-4o-mini na kvalifikaci.
SALES_MODEL_DISCOVER=""
SALES_MODEL_QUALIFY=""
SALES_MODEL_AUDIT=""
SALES_MODEL_CONTACT=""
SALES_MODEL_OUTREACH=""

# Tajemství pro Vercel Cron (ranní běhy AI Sales). openssl rand -base64 32
CRON_SECRET=""
