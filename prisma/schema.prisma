generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DEVELOPER
}

enum ClientStatus {
  LEAD
  ACTIVE
  DONE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  DONE
  ARCHIVED
}

/// Kdo záznam v komunikaci vytvořil. SYSTEM = automatická událost.
enum AuthorType {
  USER
  CLIENT
  SYSTEM
}

enum MessageKind {
  NOTE
  EMAIL
  CALL
  MEETING
  PORTAL_FEEDBACK
  SYSTEM_EVENT
}

enum AttachmentKind {
  CONTRACT
  LOGO
  INVOICE
  SCREENSHOT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Pořadí účtu Google v prohlížeči pro rychlé odkazy v navigaci ("u/6" v adrese).
  /// Každý ho má jiné. Prázdné = použije se GOOGLE_ACCOUNT_INDEX.
  googleAccountIndex Int?

  messages       Message[]
  phasesFinished ProjectPhase[]
  attachments    Attachment[]
  googleAccount  GoogleAccount?
  projectDocs    ProjectDoc[]
  contracts      Contract[]

  salesEmailApprovals SalesEmailDraft[]
  salesPromptVersions SalesPromptVersion[]
  salesEmailSamples   SalesEmailSample[]
  salesEmailRevisions SalesEmailRevision[]
}

/**
 * Smlouva k zakázce. Text se ukládá celý, ne jen parametry — model do něj může
 * zasáhnout a ruční úpravy nesmí přepsat příští složení šablony.
 */
model Contract {
  id                String   @id @default(cuid())
  projectId         String   @unique
  body              String
  totalPrice        Int
  depositPercent    Int
  hourlyRate        Int
  revisionsPerPhase Int
  paymentDays       Int
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Word vygenerovaný z textu, aby smlouva byla i v souborech zakázky.
  /// Prázdné = příloha byla smazána v Souborech, při dalším uložení vznikne nová.
  attachmentId String? @unique

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
}

/**
 * Napojení účtu na Gmail, aby šlo posílat e-maily klientům z vlastní adresy.
 * Refresh token je v databázi šifrovaný (src/lib/secrets.ts), access token se
 * ukládá jen jako krátkodobá keška, aby se nemusel obnovovat při každém odeslání.
 */
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  email        String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Údaje našeho studia do smluv. Jeden řádek s pevným id — nastavuje se
 * v Nastavení a přebíjí proměnné prostředí STUDIO_*.
 */
model StudioProfile {
  id             String   @id @default("studio")
  name           String?
  ico            String?
  dic            String?
  address        String?
  bankAccount    String?
  representedBy  String?
  updatedAt      DateTime @updatedAt
}

model Client {
  id            String       @id @default(cuid())
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  /// Fakturační údaje pro smlouvy. Do portálu se nepropisují.
  ico           String?
  address       String?
  /// Interní poznámky. Do klientského portálu se nikdy nepropisují.
  internalNote  String?
  status        ClientStatus @default(LEAD)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  projects    Project[]
  messages    Message[]
  attachments Attachment[]
  salesLeads  SalesLead[]

  @@index([status])
}

model Project {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name   String
  status ProjectStatus @default(ACTIVE)

  /// Text viditelný klientem v portálu — co se právě děje, co je potřeba od klienta.
  portalNote String?
  /// Náš nový web — staging nebo už spuštěná verze. Stávající web klienta je
  /// u klienta samotného, protože se nemění po zakázkách.
  previewUrl String?
  /// Repozitář zakázky ve tvaru owner/repo. Prázdné = zakázka repozitář nemá.
  repoFullName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases      ProjectPhase[]
  tasks       Task[]
  messages    Message[]
  approvals   Approval[]
  portalLinks PortalLink[]
  attachments Attachment[]
  docs        ProjectDoc[]
  contract    Contract?

  @@index([clientId])
  @@index([status])
}

/// Fáze zakázky. Každá zakázka má vlastní seznam — jeden web zvládne tři fáze,
/// e-shop jich potřebuje osm. Nová zakázka se předvyplní z PhaseTemplate.
model ProjectPhase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  position Int

  /// Vyplněné = fáze je ukončená. Aktivní fáze je první neukončená.
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id], onDelete: SetNull)

  /// Očekávaný termín fáze. Prázdné = v portálu se nezobrazuje.
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  approvals Approval[]

  @@unique([projectId, position])
  @@index([projectId, position])
}

model Message {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Vazba na konkrétní zakázku. Prázdné = obecná komunikace s klientem.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  authorType AuthorType
  /// Vyplněno jen když authorType = USER.
  authorId   String?
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind       MessageKind @default(NOTE)
  body       String
  pinned     Boolean     @default(false)
  editedAt   DateTime?
  createdAt  DateTime    @default(now())

  @@index([clientId, createdAt])
  @@index([projectId])
}

model Task {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   String
  phase     ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  dueDate     DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attachments Attachment[]

  @@index([phaseId, position])
  @@index([projectId])
}

/// Předloha fází pro nové zakázky. Úpravy se do rozjetých zakázek nepropisují.
model PhaseTemplate {
  id       String @id @default(cuid())
  name     String
  position Int    @unique

  tasks TaskTemplate[]
}

/// Předloha úkolů jedné fáze. Kopíruje se do Task při zakládání zakázky.
model TaskTemplate {
  id              String        @id @default(cuid())
  phaseTemplateId String
  phaseTemplate   PhaseTemplate @relation(fields: [phaseTemplateId], references: [id], onDelete: Cascade)

  title    String
  position Int    @default(0)

  @@index([phaseTemplateId, position])
}

/// Schválení fáze klientem. Oddělené od Message, protože musí být dohledatelné.
model Approval {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phaseId   String?
  phase     ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  /// Název fáze v okamžiku schválení. Zůstane i po přejmenování nebo smazání fáze.
  phaseName String

  /// IP adresa, ze které klient schválil. Slouží jako doklad.
  ipAddress    String?
  portalLinkId String?

  /// Co přesně měl klient v portálu před sebou, když schvaloval. Zmrazené
  /// při schválení, aby pozdější úprava poznámky nebo náhledu nezměnila doklad.
  /// Není to obrázek webu — na ten bychom potřebovali službu na screenshoty.
  snapshotNote       String?
  snapshotPreviewUrl String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model PortalLink {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// SHA-256 hash tokenu z URL. Deterministický, aby šel dohledat podle odkazu.
  tokenHash String @unique
  /// Argon2 hash PIN kódu. PIN se v čitelné podobě nikde neukládá.
  pinHash   String

  active         Boolean   @default(true)
  expiresAt      DateTime?
  lastVisitedAt  DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
}

model Attachment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Soubor u konkrétního úkolu, například fotka nebo podklad.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  filename        String
  kind            AttachmentKind @default(OTHER)
  mimeType        String
  size            Int
  /// Cesta v úložišti. Nikdy se nevydává klientovi přímo.
  storageKey      String
  /// Zpřístupněno klientovi v portálu.
  visibleInPortal Boolean        @default(false)

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  contract Contract?

  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([taskId])
}

/// Dokument v Google Docs založený z aplikace. Soubor patří tomu, kdo ho
/// založil — aplikace má oprávnění drive.file, tedy vidí jen na soubory, které
/// sama vytvořila. Odkaz si držíme u sebe, protože do Drive vypisovat nemůžeme.
model ProjectDoc {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title String
  /// Id souboru v Google Drive.
  docId String @unique
  /// Adresa dokumentu v Google Docs.
  webViewLink String
  /// Předloha, ze které dokument vznikl. Prázdné = prázdný dokument.
  templateKey String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// AI Sales Engine — akviziční doména. Záměrně oddělená od dodací části
// (Client, Project): Prospect je firma, kterou teprve oslovujeme. Až lead
// vyhraje, založí se z něj Client ručně — dřív se domény nepotkají.
// ---------------------------------------------------------------------------

enum SalesCampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Životní cyklus leadu podle sekce 15.1 specifikace.
enum SalesLeadStatus {
  DISCOVERED
  QUALIFYING
  QUALIFIED
  RESEARCHING
  DESIGNING
  READY_FOR_REVIEW
  APPROVED
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL
  WON
  LOST
  REJECTED
}

/// Kdy se kampaň spouští sama. NONE = jen ručně tlačítkem.
enum SalesSchedule {
  NONE
  WEEKDAYS
  DAILY
}

enum SalesRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SalesEmailStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
}

/// Kampaň: segment, mise a limity. Mise se mění v aplikaci bez nasazení —
/// stabilní identitu agenta drží SalesPromptVersion, misi kampaň.
model SalesCampaign {
  id         String              @id @default(cuid())
  name       String
  mission    String
  segment    String?
  geography  String?
  /// Nejvýš tolik kvalifikovaných leadů z jednoho běhu.
  dailyLimit Int                 @default(8)
  /// Pod tímhle skóre se lead rovnou zamítá.
  minScore   Int                 @default(60)
  status     SalesCampaignStatus @default(ACTIVE)
  schedule   SalesSchedule       @default(NONE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  leads     SalesLead[]
  runs      SalesRun[]
  agentRuns AgentRun[]
}

/// Objevená firma. Jedna firma může projít víc kampaněmi — deduplikace
/// a cooldown se řídí tady, ne na leadu.
model Prospect {
  id          String   @id @default(cuid())
  name        String
  /// Doména webu bez protokolu, klíč pro deduplikaci. U firem na sdílené
  /// platformě včetně cesty ke stránce podniku (facebook.com/nazevpodniku),
  /// protože samotná doména je společná tisícům firem.
  domain      String?  @unique
  industry    String?
  location    String?
  description String?
  createdAt   DateTime @default(now())

  leads      SalesLead[]
  contacts   SalesContact[]
  activities SalesActivity[]
}

model SalesLead {
  id             String          @id @default(cuid())
  prospectId     String
  campaignId     String
  status         SalesLeadStatus @default(DISCOVERED)
  /// Výsledné skóre příležitosti 0–100 podle rubriky v sekci 8.
  score          Int?
  businessScore  Int?
  websiteScore   Int?
  /// Digital gap: síla firmy minus kvalita webu (sekce 8.1).
  opportunityGap Int?
  /// Proč jsme firmu vybrali. Ukazuje se v review, píše ho Scout.
  reason         String?
  lostReason     String?
  /// Screenshoty webu z auditu (sekce 9.2). Klíče do úložiště souborů;
  /// vstup pro multimodální audit i budoucí Designer.
  screenshotDesktopKey String?
  screenshotMobileKey  String?
  screenshotAt         DateTime?
  /// Snímky podstránek: [{ label, key }]. Domovská stránka nestačí —
  /// rezervace nebo galerie bývají jinde a audit je jinak křivdí.
  screenshotPages      Json?
  /// Klient založený z vyhrané příležitosti. Drží prolink na zakázku;
  /// smazání klienta vazbu jen uvolní, výhra v historii zůstává.
  clientId             String?
  /// Hodnocení webu majitelem studia 0–100 — kalibrační vzor pro příští
  /// audity. Model má laťku jinde než člověk, který weby staví.
  humanWebScore        Int?
  humanWebNote         String?
  /// Vypnutý vzor zůstává uložený, ale audit ho nedostane — stejně jako
  /// u vzorových e-mailů. Mazat hodnocení kvůli jednomu auditu je škoda.
  humanWebActive       Boolean         @default(true)
  /// Vlastní poznámka majitele studia k téhle firmě — proč ji zamítl, na co
  /// si dát pozor, kdy to zkusit znovu. Modelu se neposílá, je jen pro lidi.
  ownerNote            String?
  /// Company research: { hooks: [{claim, kind, source, category}], summary }.
  /// Čerstvé háčky do úvodu e-mailu — recenze, novinky, sezóna, nábory.
  research             Json?
  /// Kdy research proběhl. NULL = fronta pro fázi research v běhu kampaně.
  researchAt           DateTime?
  /// Experiment Designera u skóre 75+: "mockup" dostane koncept homepage
  /// do přílohy, "none" je kontrolní skupina. Losuje se jednou, nemění se.
  mockupVariant        String?
  /// Klíč JPEG konceptu v úložišti; NULL u varianty "none" a pod prahem.
  mockupKey            String?
  mockupAt             DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  prospect   Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaign   SalesCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  audits     SalesAudit[]
  emails     SalesEmailDraft[]
  activities SalesActivity[]
  agentRuns  AgentRun[]

  @@unique([prospectId, campaignId])
  @@index([campaignId, status])
  @@index([status])
}

/// Kontakt s povinným původem. Bez zdroje a confidence se nesmí použít —
/// systém nikdy nehádá e-mail (sekce 10).
model SalesContact {
  id         String   @id @default(cuid())
  prospectId String
  name       String?
  role       String?
  email      String?
  phone      String?
  source     String?
  confidence Float    @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model SalesAudit {
  id               String   @id @default(cuid())
  leadId           String
  visualScore      Int?
  uxScore          Int?
  mobileScore      Int?
  conversionScore  Int?
  seoScore         Int?
  performanceScore Int?
  /// Strukturované nálezy: silné stránky, problémy, doporučení, evidence.
  findings         Json?
  summary          String?
  confidence       Float?
  createdAt        DateTime @default(now())

  lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model SalesEmailDraft {
  id              String           @id @default(cuid())
  leadId          String
  subject         String
  body            String
  /// Zvolená strategie hooku: visual, observation, business (sekce 13.2).
  strategy        String?
  promptVersionId String?
  status          SalesEmailStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  approvedAt      DateTime?
  sentAt          DateTime?
  approvedById    String?

  lead          SalesLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  promptVersion SalesPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  approvedBy    User?               @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  revisions     SalesEmailRevision[]

  @@index([leadId])
  @@index([status])
}

/**
 * Předchozí verze návrhu e-mailu. Ukládá se stav PŘED každou úpravou, takže
 * „Zpět“ je návrat o krok a seznam pokynů je historie toho, co se zkoušelo.
 */
model SalesEmailRevision {
  id          String   @id @default(cuid())
  draftId     String
  subject     String
  body        String
  /// Pokyn, který tuhle verzi vystřídal. NULL u ruční úpravy.
  instruction String?
  createdById String?
  createdAt   DateTime @default(now())

  draft     SalesEmailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([draftId, createdAt])
}

/// Timeline firmy i leadu — CRM paměť, work log agentů a doklad v jednom
/// (sekce 15, 16 a 28). Zápisy se nemažou.
model SalesActivity {
  id         String   @id @default(cuid())
  prospectId String
  leadId     String?
  /// Kdo zápis vytvořil: scout, auditor, contact, outreach, system, user.
  actor      String
  kind       String
  body       String
  meta       Json?
  createdAt  DateTime @default(now())

  prospect Prospect   @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  lead     SalesLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
  @@index([leadId, createdAt])
}

/// Jeden běh kampaně, typicky denní (sekce 22 a 37).
model SalesRun {
  id         String         @id @default(cuid())
  campaignId String
  status     SalesRunStatus @default(QUEUED)
  /// Čím ten běh je, lidsky: „Běh kampaně“, „Sken webu — Pension Alva“.
  /// Bez něj byly v seznamu jen data a stavy a nikdo nepoznal, co která
  /// položka dělala. Prázdné u běhů založených před touhle změnou.
  label      String?
  stats      Json?
  error      String?
  /// Rezervace pro právě probíhající tick. Dva souběžné ticky (řetěz +
  /// pojistka ze stránky) si běh nepřeberou — druhý bez rezervace odejde.
  claimedUntil DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime       @default(now())

  campaign  SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]

  @@index([campaignId, createdAt])
}

/// Jeden běh jednoho agenta — observabilita, cena a data lineage
/// (sekce 18.7 a 34). Zásadní tabulka celého systému.
model AgentRun {
  id              String         @id @default(cuid())
  agent           String
  runId           String?
  campaignId      String?
  leadId          String?
  status          AgentRunStatus @default(RUNNING)
  input           Json?
  output          Json?
  summary         String?
  model           String?
  promptVersionId String?
  tokensIn        Int            @default(0)
  tokensOut       Int            @default(0)
  /// Cena v mikrodolarech (1 USD = 1 000 000), ať se nesčítají floaty.
  costMicroUsd    Int            @default(0)
  error           String?
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?

  run           SalesRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  campaign      SalesCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead          SalesLead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  promptVersion SalesPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([agent, startedAt])
  @@index([runId])
  @@index([leadId])
}

/// Verze system promptů agentů (sekce 19). Aktivní je nejvýš jedna na agenta,
/// staré verze se nemažou — běhy na ně odkazují.
/**
 * Globální nastavení AI Sales. Jeden řádek s pevným id, stejně jako
 * StudioProfile — přepínače, které platí napříč kampaněmi.
 */
model SalesConfig {
  id              String   @id @default("sales")
  /// Vypnutý Designer negeneruje koncepty homepage a nekazí experiment:
  /// varianta se u nových příležitostí vůbec nelosuje.
  designerEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Vzorový e-mail od majitele studia: takhle chce, aby Outreach psal.
/// Model z něj bere tón, stavbu a délku — nikdy fakta o cizí firmě.
model SalesEmailSample {
  id          String   @id @default(cuid())
  /// Krátký název pro orientaci v seznamu („restaurace, formální“).
  label       String
  subject     String?
  body        String
  /// Co si na vzoru cenit — nálada, oslovení, čeho se vyvarovat.
  note        String?
  /// Vypnutý vzor zůstává uložený, ale k modelu nejde.
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
}

model SalesPromptVersion {
  id          String   @id @default(cuid())
  agent       String
  version     Int
  system      String
  notes       String?
  active      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  emails    SalesEmailDraft[]
  agentRuns AgentRun[]

  @@unique([agent, version])
  @@index([agent, active])
}
